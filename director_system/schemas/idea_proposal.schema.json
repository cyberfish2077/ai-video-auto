{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idea_proposal.schema.json",
  "title": "创意提案（阶段 2：5 个差异明确的故事概念）",
  "description": "DeepSeek 按 prompts/01_idea_development.md 生成；写入 projects/<film_id>/ideas.json。",
  "type": "object",
  "required": [
    "film_id",
    "concepts",
    "recommendation"
  ],
  "additionalProperties": false,
  "properties": {
    "film_id": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "logline",
          "protagonist",
          "central_contradiction",
          "visual_events",
          "causal_escalation",
          "ending",
          "emotional_promise",
          "pacing_intent",
          "production_risks",
          "strongest_feature",
          "main_weakness",
          "scores",
          "score_evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[1-9]$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "logline": {
            "type": "string",
            "minLength": 10
          },
          "protagonist": {
            "type": "object",
            "required": [
              "who",
              "goal",
              "obstacle",
              "stakes"
            ],
            "additionalProperties": false,
            "properties": {
              "who": {
                "type": "string",
                "minLength": 2
              },
              "goal": {
                "type": "string",
                "minLength": 2
              },
              "obstacle": {
                "type": "string",
                "minLength": 2
              },
              "stakes": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "central_contradiction": {
            "type": "string",
            "minLength": 10
          },
          "visual_events": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "causal_escalation": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "ending": {
            "type": "object",
            "required": [
              "what_happens",
              "how_it_was_set_up",
              "is_fair"
            ],
            "additionalProperties": false,
            "properties": {
              "what_happens": {
                "type": "string",
                "minLength": 5
              },
              "how_it_was_set_up": {
                "type": "string",
                "minLength": 5
              },
              "is_fair": {
                "type": "boolean"
              }
            }
          },
          "emotional_promise": {
            "type": "string",
            "minLength": 5
          },
          "pacing_intent": {
            "type": "string",
            "minLength": 15,
            "description": "这个方向的节奏性质与意图（例如哪里该停顿、哪里该急促、是否需要一个长镜头）。**不要在这里分配分段与帧数**——镜头边界与时长在分镜阶段按戏剧节拍决定。"
          },
          "production_risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "strongest_feature": {
            "type": "string",
            "minLength": 5
          },
          "main_weakness": {
            "type": "string",
            "minLength": 5
          },
          "scores": {
            "type": "object",
            "required": [
              "originality",
              "causal_coherence",
              "dramatic_tension",
              "visual_storytelling",
              "emotional_impact",
              "ending_strength",
              "production_feasibility"
            ],
            "additionalProperties": false,
            "properties": {
              "originality": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "causal_coherence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "dramatic_tension": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "visual_storytelling": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "emotional_impact": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "ending_strength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "production_feasibility": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          },
          "score_evidence": {
            "type": "string",
            "minLength": 15,
            "description": "分数只是启发式：这里写打分的依据与已知弱点。"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "recommended_ids",
        "tradeoffs",
        "summary_for_human"
      ],
      "additionalProperties": false,
      "properties": {
        "recommended_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^c[1-9]$"
          }
        },
        "tradeoffs": {
          "type": "string",
          "minLength": 15
        },
        "summary_for_human": {
          "type": "string",
          "minLength": 20,
          "description": "给人类选案看的中文说明：两条路线各自的取舍。"
        }
      }
    }
  }
}
